generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
}

enum UserLevel {
  STARTER
  SILVER
  GOLD
  VIP
  VVIP
}

enum TransactionType {
  TOPUP
  WITHDRAWAL
  REWARD
}

enum TransactionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  WAITING_ASSIGNMENT
  PRODUCT_ASSIGNED
  WAITING_SHIPMENT
  PENDING_DELIVERY
  DELIVERED
  REJECTED
}

model User {
  id                     String        @id @default(cuid())
  username               String        @unique @db.VarChar(64)
  displayName            String        @db.VarChar(100)
  phone                  String?       @unique @db.VarChar(32)
  passwordHash           String        @db.VarChar(255)
  withdrawalPasswordHash String?       @db.VarChar(255)
  role                   UserRole      @default(CUSTOMER)
  level                  UserLevel     @default(STARTER)
  balance                BigInt        @default(0)
  totalOrders            Int           @default(0)
  invitationCode         String?       @unique @db.VarChar(32)
  adminCode              String?       @unique @db.VarChar(32)
  registrationBonus      BigInt        @default(0)
  withdrawalLocked       Boolean       @default(false)
  withdrawalRemarks      String?       @db.Text
  isActive               Boolean       @default(true)
  referrerId             String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  lastLoginAt            DateTime?
  lastSeenAt             DateTime?

  referrer            User?         @relation("Referrals", fields: [referrerId], references: [id], onDelete: SetNull)
  referrals           User[]        @relation("Referrals")
  transactions        Transaction[] @relation("CustomerTransactions")
  reviewedTransactions Transaction[] @relation("ReviewerTransactions")
  orders              Order[]       @relation("CustomerOrders")
  managedOrders       Order[]       @relation("AdminOrders")
  orderEvents         OrderEvent[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  pushSubscriptions   PushSubscription[]

  @@index([referrerId])
  @@index([referrerId, createdAt], map: "User_referrerId_createdAt_idx")
  @@index([role, isActive])
  @@index([role, createdAt], map: "User_role_createdAt_idx")
  @@index([phone(ops: raw("text_pattern_ops"))], map: "User_phone_prefix_idx")
  @@index([lastSeenAt], map: "User_lastSeenAt_idx")
}

model Product {
  id              String      @id @default(cuid())
  code            String      @unique @db.VarChar(40)
  name            String      @db.VarChar(180)
  description     String?     @db.Text
  price           BigInt
  commission      BigInt
  requiredBalance BigInt      @default(0)
  quantity        Int         @default(0)
  category        String      @db.VarChar(80)
  imageUrl        String      @db.Text
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  orderItems      OrderItem[]

  @@index([category, active])
}

// Customer catalogue merchandise. The admin route synchronizes its editable
// task fields into Product, while this model remains unrelated to OrderItem so
// past order references stay stable. `active` controls public storefront
// visibility only; the synchronized Product remains assignable until deleted.
model CatalogProduct {
  id          String   @id @default(cuid())
  code        String   @unique @db.VarChar(40)
  name        String   @db.VarChar(180)
  description String?  @db.Text
  price       BigInt
  category    String   @db.VarChar(80)
  imageUrl    String   @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, active])
  @@index([active, price])
}

// Promotional artwork shown in the customer carousel. Banners are independent
// of both catalog products and task orders.
model CatalogBanner {
  id        String   @id @default(cuid())
  code      String   @unique @db.VarChar(40)
  title     String   @db.VarChar(160)
  altText   String   @db.VarChar(240)
  imageUrl  String   @db.Text
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

model Bank {
  id             String   @id @default(cuid())
  bankName       String   @db.VarChar(80)
  accountName    String   @db.VarChar(120)
  accountNumber  String   @db.VarChar(64)
  minimumDeposit BigInt   @default(100000)
  maximumDeposit BigInt   @default(100000000)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Transaction {
  id                      String            @id @default(cuid())
  requestNumber           String            @unique @db.VarChar(64)
  userId                  String
  reviewerId              String?
  type                    TransactionType
  amount                  BigInt
  status                  TransactionStatus @default(PENDING)
  senderName              String?           @db.VarChar(120)
  description             String?           @db.Text
  withdrawalBankName      String?           @db.VarChar(100)
  withdrawalAccountName   String?           @db.VarChar(120)
  withdrawalAccountNumber String?           @db.VarChar(80)
  proofPath               String?           @db.Text
  proofOriginalName       String?           @db.VarChar(255)
  balanceDeductedAt       DateTime?
  creditedAt              DateTime?
  reviewedAt              DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  user     User  @relation("CustomerTransactions", fields: [userId], references: [id], onDelete: Restrict)
  reviewer User? @relation("ReviewerTransactions", fields: [reviewerId], references: [id], onDelete: SetNull)
  proofFile TransactionProof?

  @@index([userId, createdAt])
  @@index([status, type, createdAt])
  @@index([createdAt], map: "Transaction_createdAt_idx")
}

model TransactionProof {
  id            String      @id @default(cuid())
  transactionId String      @unique
  mimeType      String      @db.VarChar(100)
  data          Bytes       @db.ByteA
  createdAt     DateTime    @default(now())
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model Order {
  id                       String      @id @default(cuid())
  referenceNumber          String      @unique @db.VarChar(64)
  userId                   String
  adminId                  String?
  status                   OrderStatus @default(WAITING_ASSIGNMENT)
  totalValue               BigInt      @default(0)
  commission               BigInt      @default(0)
  requiredBalance          BigInt      @default(0)
  requiresCustomerApproval Boolean     @default(false)
  assignedAt               DateTime?
  submittedAt              DateTime?
  completedAt              DateTime?
  commissionCreditedAt     DateTime?
  rating                   Int?
  review                   String?     @db.Text
  reviewedAt               DateTime?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  user   User       @relation("CustomerOrders", fields: [userId], references: [id], onDelete: Restrict)
  admin  User?      @relation("AdminOrders", fields: [adminId], references: [id], onDelete: SetNull)
  items  OrderItem[]
  events OrderEvent[]

  @@index([userId, status])
  @@index([userId, createdAt, id], map: "Order_userId_createdAt_id_idx")
  @@index([adminId, createdAt])
  @@index([status, createdAt], map: "Order_status_createdAt_idx")
  @@index([createdAt], map: "Order_createdAt_idx")
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String?
  productCode String @db.VarChar(40)
  productName String @db.VarChar(180)
  price      BigInt
  commission BigInt
  quantity   Int     @default(1)
  total      BigInt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  actorId   String?
  fromStatus OrderStatus?
  toStatus  OrderStatus
  note      String?     @db.Text
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model SiteSetting {
  key       String   @id @db.VarChar(80)
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(80)
  entityId   String?  @db.VarChar(191)
  details    Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

// A persistent per-account inbox. Read and cleared timestamps intentionally
// remain separate: reading removes the unread badge, while clearing hides the
// item without deleting the transaction or order that produced it.
model Notification {
  id          String    @id @default(cuid())
  recipientId String
  type        String    @db.VarChar(60)
  title       String    @db.VarChar(180)
  body        String    @db.VarChar(500)
  path        String    @db.VarChar(500)
  entityType  String?   @db.VarChar(80)
  entityId    String?   @db.VarChar(191)
  dedupeKey   String    @db.VarChar(255)
  readAt      DateTime?
  clearedAt   DateTime?
  createdAt   DateTime  @default(now())

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([recipientId, dedupeKey])
  @@index([recipientId, clearedAt, createdAt])
  @@index([recipientId, readAt, clearedAt])
}

// One user can enable notifications on several phones or browsers. Endpoints
// are globally unique so a shared device can never remain linked to two users.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique @db.VarChar(2048)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  userAgent String?  @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Generated once and kept in PostgreSQL so free hosts can restart without
// invalidating every phone subscription. Environment keys override this row.
model PushConfiguration {
  id         String   @id @default("primary") @db.VarChar(32)
  publicKey  String   @db.VarChar(255)
  privateKey String   @db.VarChar(255)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
